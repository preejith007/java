import java.io.*;

public class FileCopyDemo {

    public static void main(String[] args) {

        try {

            // Writing string into first file
            FileWriter fw = new FileWriter("file1.txt");

            fw.write("Welcome to Java File Handling");

            fw.close();

            // Copy contents from file1.txt to file2.txt
            FileReader fr = new FileReader("file1.txt");

            FileWriter fw2 = new FileWriter("file2.txt");

            int ch;

            while((ch = fr.read()) != -1) {

                fw2.write(ch);
            }

            fr.close();
            fw2.close();

            // Reading contents from second file
            FileReader fr2 = new FileReader("file2.txt");

            System.out.println("Contents of file2.txt:");

            while((ch = fr2.read()) != -1) {

                System.out.print((char) ch);
            }

            fr2.close();

        } catch(IOException e) {

            System.out.println("Error: " + e);
        }
    }
}
